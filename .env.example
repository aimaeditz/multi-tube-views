# Google Gemini API Key (Required for server-side AI features)
# Do NOT prefix with VITE_ or expose to client-side code.
GEMINI_API_KEY=

# Multi-Provider AI Credentials (Optional)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Application Service Host URL
APP_URL=http://localhost:3000

# Client-side API Base URL (Optional - Set during build to point static pages to deployed backend)
VITE_API_BASE_URL=

